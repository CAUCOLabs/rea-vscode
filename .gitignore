# Dependencies
node_modules/

# Build output
dist/
out/
*.vsix

# Environment variables
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*

# macOS
.DS_Store

# Editor settings
.vscode/*
!.vscode/launch.json
!.vscode/tasks.json

# Testing
coverage/
.nyc_output/

# Temporary files
*.tmp
*.swp

.vscode/settings.json

# Bundled runtimes and installed REA dependencies
# Generated locally by the distribution scripts
/runtime/node/
/runtime/rea/

# Generated build artifacts
/build/*
!/build/rea-package-lock.json

# Machine-local agent launches; keep working configurations out of source control
/.mcp.json
/.codex/

# Temporary runtime builds and recovery directories
/.runtime-build-*/
/.runtime-previous-*/

# Validated runtime candidates awaiting publication
/.runtime-candidates/

{
  "name": "rea-vscode",
  "version": "0.4.0",
  "description": "Integrate REA reverse engineering and automation tools into Visual Studio Code through MCP.",
  "main": "./dist/extension.js",
  "icon": "media/rea-icon.png",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "package": "vsce package --no-dependencies",
    "vscode:prepublish": "npm run build",
    "verify:vsix": "python3 scripts/verify_vsix.py rea-vscode-0.4.0-darwin-arm64.vsix",
    "vendor:engine": "node scripts/vendor-engine.mjs",
    "runtime:prepare": "node scripts/prepare-platform-runtime.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CAUCOLabs/rea-vscode.git"
  },
  "keywords": [
    "rea",
    "reverse-engineering",
    "mcp",
    "automation",
    "vscode"
  ],
  "author": "CAUCOLabs",
  "license": "MIT",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/CAUCOLabs/rea-vscode/issues"
  },
  "homepage": "https://github.com/CAUCOLabs/rea-vscode#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "smol-toml": "^1.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "1.102.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "displayName": "REA for VS Code",
  "publisher": "CAUCOLabs",
  "private": true,
  "engines": {
    "vscode": "^1.102.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:rea.connect",
    "onCommand:rea.listTools",
    "onCommand:rea.disconnect",
    "onView:rea.sidebar",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "REA MCP server execution is disabled in untrusted workspaces."
    }
  },
  "contributes": {
    "commands": [
      {
        "command": "rea.connect",
        "title": "REA: Connect"
      },
      {
        "command": "rea.listTools",
        "title": "REA: List Tools"
      },
      {
        "command": "rea.disconnect",
        "title": "REA: Disconnect"
      },
      {
        "command": "rea.configureCodex",
        "title": "REA: Configure Codex MCP"
      },
      {
        "command": "rea.invokeTool",
        "title": "REA: Invoke Any Tool"
      },
      {
        "command": "rea.setup",
        "title": "REA: Set Up REA"
      },
      {
        "command": "rea.diagnostics",
        "title": "REA: Verify Installation"
      },
      {
        "command": "rea.configureCopilot",
        "title": "REA: Configure Copilot MCP"
      }
    ],
    "configuration": {
      "title": "REA",
      "properties": {
        "rea.executable": {
          "type": "string",
          "scope": "machine",
          "default": "node",
          "description": "Optional Node.js override. The bundled Node.js runtime is preferred; a compatible system Node.js is used only if unavailable."
        },
        "rea.scriptPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional absolute path to a custom REA scripts/rea.mjs. Empty uses the engine bundled with this extension."
        },
        "rea.browserPath": {
          "type": "string",
          "scope": "machine",
          "default": "",
          "description": "Optional absolute path to an installed Chrome, Chromium or Edge executable. Empty uses standard installation locations."
        },
        "rea.webOperationTimeoutMs": {
          "type": "integer",
          "default": 60000,
          "minimum": 1,
          "maximum": 3600000,
          "description": "Absolute request timeout in milliseconds for browser target discovery, page inspection and screenshot capture."
        },
        "rea.bundleAnalysisTimeoutMs": {
          "type": "integer",
          "default": 300000,
          "minimum": 1,
          "maximum": 3600000,
          "description": "Absolute request timeout in milliseconds for static JavaScript bundle analysis. Timeout cancels only the request; it does not disconnect MCP."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "rea",
          "title": "REA",
          "icon": "media/rea.svg"
        }
      ]
    },
    "views": {
      "rea": [
        {
          "type": "webview",
          "id": "rea.sidebar",
          "name": "REA Explorer"
        }
      ]
    },
    "mcpServerDefinitionProviders": [
      {
        "id": "rea.engine",
        "label": "REA full engine"
      }
    ]
  },
  "extensionKind": [
    "ui"
  ]
}
